<%= form_with(model: product, class: "cart-container", style: "max-width: 650px; margin: 0 auto;") do |f| %>
  <% if product.errors.any? %>
    <div class="flash-alert" style="flex-direction: column; align-items: flex-start;">
      <h3 style="margin-bottom: 0.5rem;"><%= pluralize(product.errors.count, "error") %> prohibited this product from being saved:</h3>
      <ul>
        <% product.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :title, "Product Title", class: "form-label" %>
    <%= f.text_field :title, class: "form-control", placeholder: "e.g., MacBook Air M3" %>
  </div>

  <div class="form-group">
    <%= f.label :category_id, "Category", class: "form-label" %>
    <%= f.collection_select :category_id, @categories, :id, :name, { prompt: "Select a category" }, { class: "form-control" } %>
  </div>

  <div class="form-group">
    <%= f.label :price, "Price (₹)", class: "form-label" %>
    <%= f.number_field :price, step: "0.01", class: "form-control", placeholder: "e.g., 99999.00" %>
  </div>

  <div class="form-group">
    <%= f.label :stock, "Stock Quantity", class: "form-label" %>
    <%= f.number_field :stock, class: "form-control", placeholder: "e.g., 10" %>
  </div>

  <div class="form-group">
    <%= f.label :description, "Product Description", class: "form-label" %>
    <%= f.text_area :description, rows: 4, class: "form-control", placeholder: "Describe the features and specs..." %>
  </div>

  <div style="display: flex; gap: 1rem; margin-top: 2rem;">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", products_path, class: "btn btn-secondary" %>
  </div>
<% end %>
