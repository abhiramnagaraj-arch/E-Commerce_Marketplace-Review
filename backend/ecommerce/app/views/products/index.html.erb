<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
  <div>
    <h1 style="font-size: 2.2rem; font-weight: 700; margin-bottom: 0.25rem;">
      <%= @category ? @category.name : "All Products" %>
    </h1>
    <p style="color: var(--text-muted);">
      <%= @category ? @category.description : "Browse our premium curated selection of products" %>
    </p>
  </div>
  <div>
    <%= link_to "+ Add Product", new_product_path, class: "btn btn-primary" %>
  </div>
</div>

<!-- Category Filter Bar -->
<div class="filter-bar">
  <%= link_to "All Categories", products_path, class: "filter-chip #{'active' if @category.nil?}" %>
  <% @categories.each do |cat| %>
    <%= link_to cat.name, products_path(category_id: cat.id), class: "filter-chip #{'active' if @category&.id == cat.id}" %>
  <% end %>
</div>

<!-- Products Grid -->
<% if @products.any? %>
  <div class="products-grid">
    <% @products.each do |product| %>
      <div class="product-card">
        <div class="product-image-placeholder">
          <span class="category-tag"><%= product.category.name %></span>
          📦
        </div>
        <div class="product-info">
          <%= link_to product.title, product, class: "product-title" %>
          <p class="product-description"><%= product.description %></p>
          
          <div class="product-footer">
            <span class="product-price">₹<%= number_with_precision(product.price, precision: 2) %></span>
            <%= button_to "+ Add to Cart", add_item_cart_path(product_id: product.id), method: :post, class: "btn btn-primary btn-sm" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div style="text-align: center; padding: 4rem 2rem; background: var(--surface); border-radius: var(--radius-lg); border: 1px dashed var(--border);">
    <h3 style="margin-bottom: 1rem;">No products found in this category</h3>
    <%= link_to "Add the first product", new_product_path, class: "btn btn-primary" %>
  </div>
<% end %>
