<div style="max-width: 800px; margin: 0 auto;">
  <div class="cart-container" style="text-align: center; margin-bottom: 2rem; background: var(--success-light); border-color: var(--success);">
    <div style="font-size: 3.5rem; margin-bottom: 0.5rem;">🎉</div>
    <h1 style="color: var(--success); font-size: 2.2rem; margin-bottom: 0.5rem;">Order Successfully Confirmed!</h1>
    <p style="color: var(--text-main); font-size: 1.1rem;">
      Thank you, <strong><%= @order.customer_name %></strong>. Your order <strong>#<%= @order.id %></strong> is now being processed.
    </p>
  </div>

  <div class="cart-container">
    <div style="display: flex; justify-content: space-between; border-bottom: 2px solid var(--border); padding-bottom: 1rem; margin-bottom: 1.5rem;">
      <div>
        <h3 style="font-size: 1.3rem;">Order Details</h3>
        <p style="color: var(--text-muted); font-size: 0.9rem;">Placed on: <%= @order.created_at.strftime("%B %d, %Y at %I:%M %p") %></p>
      </div>
      <span class="cart-badge" style="background: var(--primary); color: #fff; font-size: 0.95rem; align-self: flex-start; padding: 0.4rem 1rem;">
        Status: <%= @order.status.upcase %>
      </span>
    </div>

    <div style="margin-bottom: 2rem;">
      <h4 style="margin-bottom: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-size: 0.85rem;">Shipping Address</h4>
      <p style="font-weight: 500; font-size: 1.05rem;"><%= @order.customer_name %> (<%= @order.customer_email %>)</p>
      <p style="color: var(--text-muted);"><%= @order.customer_address %></p>
    </div>

    <table class="cart-table">
      <thead>
        <tr>
          <th>Item</th>
          <th>Price</th>
          <th>Qty</th>
          <th>Subtotal</th>
        </tr>
      </thead>
      <tbody>
        <% @order.order_items.each do |item| %>
          <tr>
            <td><strong><%= item.product.title %></strong></td>
            <td>₹<%= number_with_precision(item.price, precision: 2) %></td>
            <td><%= item.quantity %></td>
            <td style="font-weight: 700;">₹<%= number_with_precision(item.total_price, precision: 2) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <div style="display: flex; flex-direction: column; align-items: flex-end; border-top: 2px solid var(--border); padding-top: 1.5rem;">
      <div style="width: 300px;">
        <div class="summary-row">
          <span>Subtotal:</span>
          <span>₹<%= number_with_precision(@order.total_amount, precision: 2) %></span>
        </div>

        <% if @order.discount_amount > 0 %>
          <div class="summary-row" style="color: var(--success); font-weight: 600;">
            <span>Discount (<%= @order.coupon_code %>):</span>
            <span>- ₹<%= number_with_precision(@order.discount_amount, precision: 2) %></span>
          </div>
        <% end %>

        <div class="summary-row summary-total">
          <span>Final Total:</span>
          <span style="color: var(--primary);">₹<%= number_with_precision(@order.final_amount, precision: 2) %></span>
        </div>
      </div>
    </div>

    <div style="display: flex; justify-content: center; gap: 1rem; margin-top: 2.5rem;">
      <%= link_to "← Continue Shopping", products_path, class: "btn btn-primary" %>
      <%= link_to "View All Orders", orders_path, class: "btn btn-secondary" %>
    </div>
  </div>
</div>
