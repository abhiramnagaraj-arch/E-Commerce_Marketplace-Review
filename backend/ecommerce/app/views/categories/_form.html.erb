<%= form_with(model: category, class: "cart-container", style: "max-width: 600px; margin: 0 auto;") do |f| %>
  <% if category.errors.any? %>
    <div class="flash-alert" style="flex-direction: column; align-items: flex-start;">
      <h3 style="margin-bottom: 0.5rem;"><%= pluralize(category.errors.count, "error") %> prohibited this category from being saved:</h3>
      <ul>
        <% category.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :name, "Category Name", class: "form-label" %>
    <%= f.text_field :name, class: "form-control", placeholder: "e.g., Laptops & Computing" %>
  </div>

  <div class="form-group">
    <%= f.label :description, "Category Description", class: "form-label" %>
    <%= f.text_area :description, rows: 4, class: "form-control", placeholder: "Briefly explain what items are in this category..." %>
  </div>

  <div style="display: flex; gap: 1rem; margin-top: 2rem;">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", categories_path, class: "btn btn-secondary" %>
  </div>
<% end %>
