<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
  <div>
    <h1 style="font-size: 2.2rem; font-weight: 700; margin-bottom: 0.25rem;">Product Categories</h1>
    <p style="color: var(--text-muted);">Manage and organize catalog sections</p>
  </div>
  <%= link_to "+ Add Category", new_category_path, class: "btn btn-primary" %>
</div>

<div class="products-grid">
  <% @categories.each do |category| %>
    <div class="product-card">
      <div class="product-info">
        <h3 style="font-size: 1.4rem; font-weight: 700; margin-bottom: 0.5rem;">
          <%= link_to category.name, category, class: "product-title" %>
        </h3>
        <p class="product-description" style="margin-bottom: 1rem;"><%= category.description %></p>
        <div class="product-footer">
          <span class="cart-badge" style="background: var(--primary-light);"><%= category.products.count %> products</span>
          <div style="display: flex; gap: 0.5rem;">
            <%= link_to "View", category, class: "btn btn-secondary btn-sm" %>
            <%= link_to "Edit", edit_category_path(category), class: "btn btn-secondary btn-sm" %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
