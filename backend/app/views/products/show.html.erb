<div style="max-width: 900px; margin: 0 auto; background: var(--surface); border-radius: var(--radius-lg); border: 1px solid var(--border); overflow: hidden; box-shadow: var(--shadow-md);">
  <div class="product-image-placeholder" style="height: 320px; font-size: 5rem;">
    <span class="category-tag"><%= @product.category.name %></span>
    ⚡
  </div>

  <div style="padding: 2.5rem;">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.5rem;">
      <div>
        <h1 style="font-size: 2.4rem; font-weight: 700; margin-bottom: 0.5rem;"><%= @product.title %></h1>
        <p style="color: var(--text-muted); font-size: 1.05rem;">Category: <%= @product.category.name %></p>
      </div>
      <span style="font-size: 2.2rem; font-weight: 700; color: var(--primary);">
        ₹<%= number_with_precision(@product.price, precision: 2) %>
      </span>
    </div>

    <p style="font-size: 1.1rem; line-height: 1.8; color: var(--text-main); margin-bottom: 2rem;">
      <%= @product.description %>
    </p>

    <div style="display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--border); padding-top: 1.5rem;">
      <div style="display: flex; gap: 0.75rem;">
        <% if user_signed_in? && current_user.buyer? %>
          <%= button_to "🛒 Add to Cart", add_item_buyer_cart_path(product_id: @product.id), method: :post, class: "btn btn-primary", disabled: @product.stock.zero? %>
        <% end %>
        <%= link_to "← Back to Products", products_path, class: "btn btn-secondary" %>
      </div>

      <% if user_signed_in? && current_user.seller? && @product.seller == current_user %>
        <div style="display: flex; gap: 0.5rem;">
          <%= link_to "Edit", edit_seller_product_path(@product), class: "btn btn-secondary btn-sm" %>
          <%= button_to "Archive", seller_product_path(@product), method: :delete, data: { turbo_confirm: "Archive this product?" }, class: "btn btn-danger btn-sm" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
