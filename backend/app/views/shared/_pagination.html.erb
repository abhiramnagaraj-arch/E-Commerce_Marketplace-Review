<% if total_pages > 1 %>
  <nav class="pagination">
    <% if page > 1 %>
      <%= link_to "Previous", url_for(request.query_parameters.merge(param.to_s => page - 1)) %>
    <% end %>

    <% (1..total_pages).each do |number| %>
      <%= link_to number, url_for(request.query_parameters.merge(param.to_s => number)), class: ("active" if number == page) %>
    <% end %>

    <% if page < total_pages %>
      <%= link_to "Next", url_for(request.query_parameters.merge(param.to_s => page + 1)) %>
    <% end %>
  </nav>
<% end %>
