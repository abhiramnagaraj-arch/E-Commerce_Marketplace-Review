<%= form_with model: [:seller, product], class: "form-card" do |f| %>
  <% if product.errors.any? %>
    <div class="flash-alert">
      <ul>
        <% product.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :title, class: "form-label" %>
    <%= f.text_field :title, class: "form-control", required: true %>
  </div>

  <div class="form-group">
    <%= f.label :category_id, "Category", class: "form-label" %>
    <%= f.collection_select :category_id, @categories, :id, :name, { prompt: "Select a category" }, class: "form-control", required: true %>
  </div>

  <div class="form-row">
    <div class="form-group">
      <%= f.label :price, "Price", class: "form-label" %>
      <%= f.number_field :price, min: 0, step: 0.01, class: "form-control", required: true %>
    </div>

    <div class="form-group">
      <%= f.label :stock, class: "form-label" %>
      <%= f.number_field :stock, min: 0, class: "form-control", required: true %>
    </div>
  </div>

  <div class="form-group">
    <%= f.label :description, class: "form-label" %>
    <%= f.text_area :description, rows: 5, class: "form-control" %>
  </div>

  <% if product.persisted? %>
    <div class="form-group">
      <%= f.check_box :active %>
      <%= f.label :active, "Available to buyers" %>
    </div>
  <% end %>

  <div class="actions">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", seller_products_path, class: "btn btn-secondary" %>
  </div>
<% end %>
