<div class="page-header">
  <div>
    <h1>Categories</h1>
    <p class="muted">View your products by category.</p>
  </div>
  <%= link_to "Add product", new_seller_product_path, class: "btn btn-primary" %>
</div>

<div class="products-grid">
  <% @categories.each do |category| %>
    <div class="product-card">
      <div class="product-info">
        <%= link_to category.name, seller_category_path(category), class: "product-title" %>
        <p class="product-description"><%= category.description %></p>
        <div class="product-footer">
          <span class="muted"><%= @product_counts.fetch(category.id, 0) %> products</span>
          <%= link_to "View", seller_category_path(category), class: "btn btn-secondary btn-sm" %>
        </div>
      </div>
    </div>
  <% end %>
</div>
