<div class="page-header">
  <div>
    <h1>Categories</h1>
    <p class="muted">View your products by category.</p>
  </div>
  <%= link_to "Add product", new_seller_product_path, class: "btn btn-primary" %>
</div>

<div class="products-grid">
  <% @categories.each do |category| %>
    <%= render "categories/category_card",
               category: category,
               destination: seller_category_path(category),
               product_count: @product_counts.fetch(category.id, 0) %>
  <% end %>
</div>
