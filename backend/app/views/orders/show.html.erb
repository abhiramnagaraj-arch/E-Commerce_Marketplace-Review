<div class="page-header">
  <div>
    <h1>Order #<%= @order.id %></h1>
    <p class="muted">Status: <%= @order.status.titleize %></p>
  </div>
  <%= link_to "All orders", buyer_orders_path, class: "btn btn-secondary" %>
</div>

<div class="list-card">
  <h2>Delivery details</h2>
  <p><strong><%= @order.customer_name %></strong></p>
  <p><%= @order.customer_email %></p>
  <p><%= @order.customer_address %></p>
</div>

<% @seller_orders.each do |seller_order| %>
  <div class="list-card">
    <div class="section-heading">
      <h2><%= seller_order.seller.name %></h2>
      <strong><%= seller_order.status.titleize %></strong>
    </div>

    <% seller_order.order_items.each do |item| %>
      <div class="list-row">
        <span><%= item.product_title %> × <%= item.quantity %></span>
        <strong>₹<%= number_with_precision(item.final_amount, precision: 2) %></strong>
      </div>
    <% end %>

    <% if seller_order.rejected? %>
      <p><strong>Rejected:</strong> <%= seller_order.rejection_reason %></p>
    <% end %>
  </div>
<% end %>

<div class="list-card">
  <div class="summary-row">
    <span>Subtotal</span>
    <span>₹<%= number_with_precision(@order.total_amount, precision: 2) %></span>
  </div>

  <% if @order.discount_amount.positive? %>
    <div class="summary-row">
      <span><%= @order.promotion_name || "Promotion discount" %></span>
      <span>- ₹<%= number_with_precision(@order.discount_amount, precision: 2) %></span>
    </div>
  <% end %>

  <div class="summary-row summary-total">
    <span>Total</span>
    <span>₹<%= number_with_precision(@order.final_amount, precision: 2) %></span>
  </div>
</div>

<% if @order.may_cancel_order? %>
  <%= form_with url: cancel_buyer_order_path(@order), method: :patch, class: "form-card" do |form| %>
    <h2>Cancel order</h2>
    <p class="muted">You can cancel while no seller has shipped an item.</p>

    <div class="form-group">
      <%= form.label :cancel_reason, "Reason", class: "form-label" %>
      <%= form.text_area :cancel_reason, rows: 3, class: "form-control", required: true %>
    </div>

    <%= form.submit "Cancel order", class: "btn btn-danger", data: { turbo_confirm: "Cancel this order?" } %>
  <% end %>
<% elsif @order.status == "canceled" && @order.cancel_reason.present? %>
  <div class="list-card">
    <h2>Cancellation reason</h2>
    <p><%= @order.cancel_reason %></p>
  </div>
<% end %>
