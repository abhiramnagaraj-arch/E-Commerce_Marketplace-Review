<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Rediff Store — MVC E-Commerce Demo" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="navbar">
      <div class="nav-container">
        <%= link_to root_path, class: "brand-logo" do %>
          <span>⚡ Rediff Store</span>
        <% end %>

        <nav>
          <ul class="nav-links">
            <li><%= link_to "Home", root_path, class: "nav-link" %></li>
            <% if user_signed_in? && current_user.buyer? %>
              <li><%= link_to "Categories", categories_path, class: "nav-link" %></li>
            <% elsif user_signed_in? && current_user.seller? %>
              <li><%= link_to "Categories", seller_categories_path, class: "nav-link" %></li>
            <% elsif user_signed_in? && current_user.admin? %>
              <li><%= link_to "Categories", admin_categories_path, class: "nav-link" %></li>
            <% else %>
              <li><%= link_to "Categories", categories_path, class: "nav-link" %></li>
            <% end %>
            <li><%= link_to "Products", products_path, class: "nav-link" %></li>
            <% if user_signed_in? && current_user.buyer? %>
              <li><%= link_to "Dashboard", buyer_root_path, class: "nav-link" %></li>
              <li><%= link_to "Orders", buyer_orders_path, class: "nav-link" %></li>
              <li>
                <%= link_to buyer_cart_path, class: "cart-btn" do %>
                  <span>🛒 Cart</span>
                  <%= render "shared/cart_item_count" %>
                <% end %>
              </li>
            <% elsif user_signed_in? && current_user.seller? %>
              <li><%= link_to "Seller Dashboard", seller_root_path, class: "nav-link" %></li>
              <li><%= link_to "My Products", seller_products_path, class: "nav-link" %></li>
              <li><%= link_to "Orders", seller_orders_path, class: "nav-link" %></li>
            <% elsif user_signed_in? && current_user.admin? %>
              <li><%= link_to "Admin Dashboard", admin_root_path, class: "nav-link" %></li>
              <li><%= link_to "Orders", admin_orders_path, class: "nav-link" %></li>
              <li><%= link_to "Promotions", admin_promotions_path, class: "nav-link" %></li>
            <% end %>
            <% if user_signed_in? %>
              <li><%= link_to "Account", edit_user_registration_path, class: "nav-link" %></li>
              <li><%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "btn btn-secondary btn-sm" %></li>
            <% else %>
              <li><%= link_to "Sign in", new_user_session_path, class: "nav-link" %></li>
              <li><%= link_to "Register", new_user_registration_path, class: "btn btn-primary btn-sm" %></li>
            <% end %>
          </ul>
        </nav>
      </div>
    </header>

    <main class="main-content">
      <div id="flash_messages">
        <%= render "shared/flash_messages" %>
      </div>

      <%= yield %>
    </main>

    <footer class="footer">
      <div class="nav-container" style="justify-content: center;">
        <p>Rediff E-Commerce System</p>
      </div>
    </footer>
  </body>
</html>
