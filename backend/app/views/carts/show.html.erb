<div class="page-header">
  <div>
    <h1>Your Cart</h1>
    <p class="muted">Review your items before checkout.</p>
  </div>
  <%= link_to "Continue shopping", products_path, class: "btn btn-secondary" %>
</div>

<% if @all_cart_items.any? %>
  <div class="cart-layout">
    <div class="cart-container">
      <% @cart_items.each do |item| %>
        <div class="cart-item-row">
          <div class="cart-item-info">
            <%= link_to item.product.title, product_path(item.product), class: "product-title" %>
            <p class="muted">₹<%= number_with_precision(item.product.price, precision: 2) %> each</p>
          </div>

          <div class="quantity-controls">
            <%= button_to "−", decrement_item_buyer_cart_path(id: item.id), method: :patch, class: "quantity-button", data: { turbo: false } %>
            <strong><%= item.quantity %></strong>
            <%= button_to "+", increment_item_buyer_cart_path(id: item.id), method: :patch, class: "quantity-button", data: { turbo: false } %>
          </div>

          <strong>₹<%= number_with_precision(item.total_price, precision: 2) %></strong>
          <%= button_to "Remove", remove_item_buyer_cart_path(id: item.id), method: :delete, class: "btn btn-danger btn-sm" %>
        </div>
      <% end %>

      <%= render "shared/pagination", page: @items_page, total_pages: @items_total_pages, param: :items_page %>

      <div class="promotion-section">
        <h2>Available Offers</h2>

        <% @offers.each do |info| %>
          <% offer = info[:offer] %>

          <div class="offer-card <%= "picked" if @picked_id == offer.id %>">
            <div>
              <strong><%= offer.name %></strong>
              <% if offer.code.present? %>
                <span class="offer-code"><%= offer.code %></span>
              <% end %>
              <% if @recommended_id == offer.id %>
                <span class="recommended">Recommended</span>
              <% end %>

              <% if info[:level] %>
                <p>
                  <%= info[:level].discount_percent %>% off ·
                  You save ₹<%= number_with_precision(info[:saving], precision: 2) %>
                </p>

                <% if info[:next] %>
                  <p class="muted">
                    <% if offer.product_discount? %>
                      Add <%= info[:left].to_i %> more qualifying items
                    <% else %>
                      Spend ₹<%= number_with_precision(info[:left], precision: 2) %> more
                    <% end %>
                    to unlock <%= info[:next].discount_percent %>% off.
                  </p>
                <% end %>
              <% else %>
                <p class="muted">
                  <% if offer.product_discount? %>
                    Add <%= info[:left].to_i %> qualifying items
                  <% else %>
                    Spend ₹<%= number_with_precision(info[:left], precision: 2) %>
                  <% end %>
                  to unlock <%= info[:next].discount_percent %>% off.
                </p>
              <% end %>
            </div>

            <% if info[:level] %>
              <% if @picked_id == offer.id %>
                <span class="offer-state selected">Selected</span>
              <% else %>
                <%= button_to "Select",
                              pick_offer_buyer_cart_path(promotion_id: offer.id),
                              class: "btn btn-primary btn-sm" %>
              <% end %>
            <% else %>
              <span class="offer-state">Not unlocked</span>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="cart-container summary-panel">
      <h2>Cart Total</h2>
      <div class="summary-row">
        <span>Items (<%= @summary[:item_count] %>)</span>
        <span>₹<%= number_with_precision(@summary[:subtotal], precision: 2) %></span>
      </div>

      <% if @summary[:discount].positive? %>
        <div class="summary-row discount-text">
          <span><%= @summary[:promotion].name %></span>
          <span>− ₹<%= number_with_precision(@summary[:discount], precision: 2) %></span>
        </div>
      <% end %>

      <div class="summary-row summary-total">
        <span>Total</span>
        <span>₹<%= number_with_precision(@summary[:total], precision: 2) %></span>
      </div>

      <%= link_to "Checkout", new_buyer_order_path, class: "btn btn-primary full-width" %>
    </div>
  </div>
<% else %>
  <div class="empty-state list-card">
    <h2>Your cart is empty</h2>
    <p class="muted">Add a product to get started.</p>
    <%= link_to "Browse products", products_path, class: "btn btn-primary" %>
  </div>
<% end %>
