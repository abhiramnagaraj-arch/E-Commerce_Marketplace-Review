<div class="page-header">
  <div>
    <h1>Categories</h1>
    <p class="muted">Browse products by category.</p>
  </div>
</div>

<div class="products-grid">
  <% @categories.each do |category| %>
    <%= render "categories/category_card",
               category: category,
               destination: category_path(category),
               product_count: @product_counts.fetch(category.id, 0) %>
  <% end %>
</div>
