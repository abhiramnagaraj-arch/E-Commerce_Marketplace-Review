<% @sales.each do |sale| %>
  <%= render "promotions/sale_banner", sale: sale %>
<% end %>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
  <div>
    <h1 style="font-size: 2.2rem; font-weight: 700; margin-bottom: 0.25rem;"><%= @category.name %></h1>
    <p style="color: var(--text-muted);"><%= @category.description %></p>
  </div>
  <%= link_to "Back to categories", categories_path, class: "btn btn-secondary" %>
</div>

<% @category_offers.each do |offer| %>
  <%= render "promotions/category_banner", offer: offer, category: @category %>
<% end %>

<h2 style="margin-bottom: 1.5rem;">Products in <%= @category.name %> (<%= @product_count %>)</h2>

<% if @products.any? %>
  <div class="products-grid">
    <% @products.each do |product| %>
      <div class="product-card">
        <div class="product-image-placeholder">
          📦
        </div>
        <div class="product-info">
          <%= link_to product.title, product, class: "product-title" %>
          <p class="product-description"><%= product.description %></p>
          <% @product_offers.fetch(product.id, []).each do |offer| %>
            <%= render "promotions/product_offer", offer: offer %>
          <% end %>
          <div class="product-footer">
            <span class="product-price">₹<%= number_with_precision(product.price, precision: 2) %></span>
            <% if user_signed_in? && current_user.buyer? %>
              <%= render "products/cart_controls", product: product, cart_item: cart_item_for(product) %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
  <%= render "shared/pagination", page: @page, total_pages: @total_pages, param: :page %>
<% else %>
  <p>No products in this category yet.</p>
<% end %>
