<%= form_with model: [:admin, category], class: "form-card" do |form| %>
  <% if category.errors.any? %>
    <div class="flash-alert">
      <%= category.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name, class: "form-control", required: true %>
  </div>

  <div class="form-group">
    <%= form.label :description, class: "form-label" %>
    <%= form.text_area :description, rows: 4, class: "form-control" %>
  </div>

  <div class="actions">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", admin_categories_path, class: "btn btn-secondary" %>
  </div>
<% end %>
