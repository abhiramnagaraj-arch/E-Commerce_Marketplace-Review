<div class="page-header">
  <div>
    <h1>Order #<%= @order.id %></h1>
    <p class="muted">Status: <%= @order.status.titleize %></p>
  </div>
  <%= link_to "Back to orders", admin_orders_path, class: "btn btn-secondary" %>
</div>

<div class="list-card">
  <h2>Customer</h2>
  <p><strong><%= @order.customer_name %></strong></p>
  <p><%= @order.customer_email %></p>
  <p><%= @order.customer_address %></p>
</div>

<% @seller_orders.each do |seller_order| %>
  <div class="list-card">
    <div class="section-heading">
      <h2><%= seller_order.seller.name %></h2>
      <strong><%= seller_order.status.titleize %></strong>
    </div>

    <% seller_order.order_items.each do |item| %>
      <div class="list-row">
        <div>
          <strong><%= item.product_title %> × <%= item.quantity %></strong>
          <p class="muted">
            Listed: ₹<%= number_with_precision(item.subtotal, precision: 2) %> ·
            Discount: ₹<%= number_with_precision(item.discount_amount, precision: 2) %> ·
            Buyer paid: ₹<%= number_with_precision(item.final_amount, precision: 2) %>
          </p>
        </div>
      </div>
    <% end %>

    <div class="summary-row">
      <span>Seller amount</span>
      <span>₹<%= number_with_precision(seller_order.seller_total, precision: 2) %></span>
    </div>
    <div class="summary-row">
      <span>Store discount</span>
      <span>₹<%= number_with_precision(seller_order.promotion_total, precision: 2) %></span>
    </div>

    <div class="actions">
      <% if seller_order.may_process? %>
        <%= button_to "Start processing", process_order_admin_seller_order_path(seller_order), method: :patch, class: "btn btn-primary" %>
      <% end %>

      <% if seller_order.may_ship? %>
        <%= button_to "Mark as shipped", ship_admin_seller_order_path(seller_order), method: :patch, class: "btn btn-primary" %>
      <% end %>

      <% if seller_order.may_deliver? %>
        <%= button_to "Mark as delivered", deliver_admin_seller_order_path(seller_order), method: :patch, class: "btn btn-primary" %>
      <% end %>
    </div>

    <% if seller_order.may_reject? %>
      <%= form_with url: reject_admin_seller_order_path(seller_order), method: :patch, class: "form-card" do |form| %>
        <div class="form-group">
          <%= form.label :rejection_reason, "Rejection reason", class: "form-label" %>
          <%= form.text_area :rejection_reason, rows: 2, class: "form-control", required: true %>
        </div>
        <%= form.submit "Reject seller order", class: "btn btn-danger", data: { turbo_confirm: "Reject this seller order?" } %>
      <% end %>
    <% elsif seller_order.rejected? %>
      <p><strong>Rejection reason:</strong> <%= seller_order.rejection_reason %></p>
    <% end %>
  </div>
<% end %>

<div class="list-card">
  <% if @order.promotion_name.present? %>
    <p><strong>Promotion:</strong> <%= @order.promotion_name %></p>
  <% end %>
  <div class="summary-row">
    <span>Listed product total</span>
    <span>₹<%= number_with_precision(@order.total_amount, precision: 2) %></span>
  </div>
  <div class="summary-row">
    <span>Store promotion expense</span>
    <span>₹<%= number_with_precision(@order.discount_amount, precision: 2) %></span>
  </div>
  <div class="summary-row summary-total">
    <span>Buyer paid</span>
    <span>₹<%= number_with_precision(@order.final_amount, precision: 2) %></span>
  </div>
</div>

<% if @order.may_cancel_order? %>
  <%= form_with url: cancel_admin_order_path(@order), method: :patch, class: "form-card" do |form| %>
    <h2>Cancel complete order</h2>
    <div class="form-group">
      <%= form.label :cancel_reason, "Reason", class: "form-label" %>
      <%= form.text_area :cancel_reason, rows: 3, class: "form-control", required: true %>
    </div>
    <%= form.submit "Cancel order", class: "btn btn-danger", data: { turbo_confirm: "Cancel this complete order?" } %>
  <% end %>
<% end %>
